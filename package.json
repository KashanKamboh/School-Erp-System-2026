{
  "name": "edupulse-school-erp",
  "productName": "EduPulse School ERP",
  "description": "Professional offline-ready School ERP system with local SQLite database for Windows desktop",
  "author": "EduPulse Software",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "reset:install": "node scripts/reset-install.mjs",
    "dev": "npm run rebuild:node && tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "npm run rebuild:node && node dist/server.cjs",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit",
    "electron:build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-electron/main.cjs",
    "electron:build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-electron/preload.cjs",
    "electron:build:all": "npm run electron:build:main && npm run electron:build:preload",
    "electron:dev": "npm run electron:build:all && npm run rebuild:electron && electron dist-electron/main.cjs",
    "electron:build": "npm run build && npm run electron:build:all && npm run rebuild:electron && electron-builder --win --x64 --publish never",
    "electron:pack": "npm run build && npm run electron:build:all && npm run rebuild:electron && electron-builder --dir"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.11.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "validator": "^13.15.35",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/validator": "^13.15.10",
    "autoprefixer": "^10.4.21",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "isomorphic-git": "^1.42.2",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
